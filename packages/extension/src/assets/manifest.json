{
  "manifest_version": 3,
  "name": "Skimlet",
  "version": "0.2.0",
  "minimum_chrome_version": "125",
  "description": "Connect Chrome to Skimlet for search results and batch page extraction.",
  "key": "",
  "permissions": [
    "activeTab",
    "debugger",
    "tabGroups"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Attach this tab to Skimlet",
    "default_icon": "icons/off.png"
  },
  "icons": {
    "32": "icons/off.png",
    "128": "icons/store-128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src ws://127.0.0.1:19989"
  }
}
